  experience
  event
  user
  business
}

// ═══════════════════ 1. İSTİFADƏÇİ (8 cədvəl) ═══════════════════

model User {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  publicId     String     @unique @map("public_id") @db.Char(26)
  username     String     @unique @db.VarChar(32)
  email        String?    @unique @db.VarChar(190)
  phone        String?    @unique @db.VarChar(24)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(120)
  bio          String?    @db.VarChar(300)
  gender       Gender     @default(unspecified)
  birthDate    DateTime?  @map("birth_date") @db.Date
  role         UserRole   @default(gezgin)
  status       UserStatus @default(active)

  avatarId     BigInt? @map("avatar_id") @db.UnsignedBigInt
  coverId      BigInt? @map("cover_id") @db.UnsignedBigInt
  homeRegionId BigInt? @map("home_region_id") @db.UnsignedBigInt

  level       Int @default(1) @db.UnsignedSmallInt
  xp          Int @default(0) @db.UnsignedInt
  gezginScore Int @default(0) @map("gezgin_score") @db.UnsignedInt

  isPublic        Boolean   @default(true) @map("is_public")
  isVerified      Boolean   @default(false) @map("is_verified")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.DateTime(3)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.DateTime(3)
  lastActiveAt    DateTime? @map("last_active_at") @db.DateTime(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  avatar     MediaAsset? @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  cover      MediaAsset? @relation("UserCover", fields: [coverId], references: [id], onDelete: SetNull)
  homeRegion Region?     @relation(fields: [homeRegionId], references: [id], onDelete: SetNull)

  settings             UserSettings?
  notificationPrefs    NotificationPreference?
  expertProfile        ExpertProfile?
  interests            UserInterest[]
  otpCodes             OtpCode[]
  refreshTokens        RefreshToken[]
  devices              Device[]
  following            Follow[]                  @relation("Follower")
  followers            Follow[]                  @relation("Following")
  blocksMade           Block[]                   @relation("Blocker")
  blocksReceived       Block[]                   @relation("Blocked")
  places               Place[]                   @relation("PlaceCreator")
  placePhotos          PlacePhoto[]
  routes               Route[]
  experiences          Experience[]
  businesses           Business[]
  trips                Trip[]
  bookings             Booking[]
  paymentMethods       PaymentMethod[]
  payouts              Payout[]
  posts                Post[]
  postLikes            PostLike[]
  comments             Comment[]
  commentLikes         CommentLike[]
  stories              Story[]
  storyViews           StoryView[]
  reviews              Review[]
  reviewHelpful        ReviewHelpful[]
  reviewReplies        ReviewReply[]
  savedItems           SavedItem[]
  collections          Collection[]
  badges               UserBadge[]
  xpTransactions       XpTransaction[]
  checkins             Checkin[]
  leaderboardSnapshots LeaderboardSnapshot[]
  notifications        Notification[]
  conversations        ConversationParticipant[]
  messages             Message[]
  expertApplication    ExpertApplication?
  subscriptions        Subscription[]
  mediaUploads         MediaAsset[]              @relation("MediaOwner")
  reportsMade          Report[]                  @relation("Reporter")
  reportsReceived      Report[]                  @relation("ReportedUser")
  searchHistory        SearchHistory[]
  auditLogs            AuditLog[]
  eventAttendance      EventAttendee[]
  offlineDownloads     OfflineDownload[]

  @@index([role, status])
  @@index([homeRegionId])
  @@index([gezginScore(sort: Desc)])
  @@index([createdAt])
  @@map("users")
}

model UserSettings {
  userId            BigInt         @id @map("user_id") @db.UnsignedBigInt
  language          Language       @default(az)
  currency          String         @default("AZN") @db.Char(3)
  darkMode          Boolean        @default(false) @map("dark_mode")
  pushEnabled       Boolean        @default(true) @map("push_enabled")
  emailEnabled      Boolean        @default(true) @map("email_enabled")
  locationEnabled   Boolean        @default(true) @map("location_enabled")
  wifiOnlyDownload  Boolean        @default(true) @map("wifi_only_download")
  profileVisibility PostVisibility @default(public) @map("profile_visibility")
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserInterest {
  userId     BigInt   @map("user_id") @db.UnsignedBigInt
  categoryId BigInt   @map("category_id") @db.UnsignedBigInt
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
  @@map("user_interests")
}

model OtpCode {
  id         BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt?    @map("user_id") @db.UnsignedBigInt
  target     String     @db.VarChar(190)
  channel    OtpChannel
  purpose    OtpPurpose
  codeHash   String     @map("code_hash") @db.VarChar(255)
  attempts   Int        @default(0) @db.UnsignedTinyInt
  expiresAt  DateTime   @map("expires_at") @db.DateTime(3)
  consumedAt DateTime?  @map("consumed_at") @db.DateTime(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose, expiresAt])
  @@index([userId])
  @@map("otp_codes")
}

model RefreshToken {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  family       String    @db.Char(26)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  ip           String?   @db.VarChar(45)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)
  replacedById BigInt?   @map("replaced_by_id") @db.UnsignedBigInt
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([family])
  @@map("refresh_tokens")
}

model Device {
  id         BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt         @map("user_id") @db.UnsignedBigInt
  platform   DevicePlatform
  pushToken  String         @map("push_token") @db.VarChar(255)
  appVersion String?        @map("app_version") @db.VarChar(24)
  locale     String?        @db.VarChar(10)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.DateTime(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pushToken])
  @@index([platform])
  @@map("devices")
}

model Follow {
  followerId  BigInt   @map("follower_id") @db.UnsignedBigInt
  followingId BigInt   @map("following_id") @db.UnsignedBigInt
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
  @@map("follows")
}

model Block {
  blockerId BigInt   @map("blocker_id") @db.UnsignedBigInt
  blockedId BigInt   @map("blocked_id") @db.UnsignedBigInt
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

// ═══════════════════ 2. KONTENT (12 cədvəl) ═══════════════════

model Region {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId   String   @unique @map("public_id") @db.Char(26)
  slug       String   @unique @db.VarChar(80)
  parentId   BigInt?  @map("parent_id") @db.UnsignedBigInt
  lat        Decimal? @db.Decimal(10, 7)
  lng        Decimal? @db.Decimal(10, 7)
  coverId    BigInt?  @map("cover_id") @db.UnsignedBigInt
  isFeatured Boolean  @default(false) @map("is_featured")
  placeCount Int      @default(0) @map("place_count") @db.UnsignedInt
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  parent       Region?             @relation("RegionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Region[]            @relation("RegionTree")
  cover        MediaAsset?         @relation(fields: [coverId], references: [id], onDelete: SetNull)
  translations RegionTranslation[]
  places       Place[]
  routes       Route[]
  experiences  Experience[]
  events       Event[]
  businesses   Business[]
  users        User[]
  checkins     Checkin[]
  offlinePkg   OfflinePackage?

  @@index([parentId])
  @@index([isFeatured, sortOrder])
  @@map("regions")
}

model RegionTranslation {
  regionId    BigInt   @map("region_id") @db.UnsignedBigInt
  lang        Language
  name        String   @db.VarChar(120)
  description String?  @db.Text

  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([regionId, lang])
  @@fulltext([name, description])
  @@map("region_translations")
}

model Category {
  id        BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  slug      String  @unique @db.VarChar(60)
  nameAz    String  @map("name_az") @db.VarChar(80)
  nameEn    String  @map("name_en") @db.VarChar(80)
  nameRu    String  @map("name_ru") @db.VarChar(80)
  icon      String? @db.VarChar(60)
  types     String  @db.VarChar(120) // "place|route|experience" — CategoryType siyahısı
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  places      PlaceCategory[]
  interests   UserInterest[]
  experiences Experience[]
  routes      Route[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Place {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId    String        @unique @map("public_id") @db.Char(26)
  slug        String        @unique @db.VarChar(120)
  regionId    BigInt        @map("region_id") @db.UnsignedBigInt
  createdById BigInt?       @map("created_by_id") @db.UnsignedBigInt
  status      ContentStatus @default(published)

  lat       Decimal @db.Decimal(10, 7)
  lng       Decimal @db.Decimal(10, 7)
  altitudeM Int?    @map("altitude_m") @db.SmallInt
  address   String? @db.VarChar(255)
  phone     String? @db.VarChar(24)
  website   String? @db.VarChar(190)

  bestSeason     String?  @map("best_season") @db.VarChar(60)
  visitDurationH Decimal? @map("visit_duration_h") @db.Decimal(4, 1)
  entranceFeeAzn Decimal? @map("entrance_fee_azn") @db.Decimal(8, 2)

  ratingAvg    Decimal @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount  Int     @default(0) @map("rating_count") @db.UnsignedInt
  saveCount    Int     @default(0) @map("save_count") @db.UnsignedInt
  checkinCount Int     @default(0) @map("checkin_count") @db.UnsignedInt
  isFeatured   Boolean @default(false) @map("is_featured")

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  region       Region             @relation(fields: [regionId], references: [id], onDelete: Restrict)
  createdBy    User?              @relation("PlaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  translations PlaceTranslation[]
  photos       PlacePhoto[]
  categories   PlaceCategory[]
  routeStops   RouteStop[]
  tripItems    TripItem[]
  checkins     Checkin[]
  posts        Post[]
  experiences  Experience[]

  @@index([regionId, status])
  @@index([isFeatured, ratingAvg(sort: Desc)])
  @@index([lat, lng])
  @@map("places")
}

model PlaceTranslation {
  placeId     BigInt   @map("place_id") @db.UnsignedBigInt
  lang        Language
  name        String   @db.VarChar(160)
  description String?  @db.Text

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([placeId, lang])
  @@fulltext([name, description])
  @@map("place_translations")
}

model PlacePhoto {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  placeId      BigInt   @map("place_id") @db.UnsignedBigInt
  mediaId      BigInt   @map("media_id") @db.UnsignedBigInt
  uploadedById BigInt?  @map("uploaded_by_id") @db.UnsignedBigInt
  isOfficial   Boolean  @default(false) @map("is_official")
  isCover      Boolean  @default(false) @map("is_cover")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  place      Place      @relation(fields: [placeId], references: [id], onDelete: Cascade)
  media      MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  uploadedBy User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([placeId, isCover, sortOrder])
  @@index([mediaId])
  @@index([uploadedById])
  @@map("place_photos")
}

model PlaceCategory {
  placeId    BigInt  @map("place_id") @db.UnsignedBigInt
  categoryId BigInt  @map("category_id") @db.UnsignedBigInt
  isPrimary  Boolean @default(false) @map("is_primary")

  place    Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([placeId, categoryId])
  @@index([categoryId])
  @@map("place_categories")
}

model Event {
  id       BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId String        @unique @map("public_id") @db.Char(26)
  slug     String        @unique @db.VarChar(120)
  regionId BigInt        @map("region_id") @db.UnsignedBigInt
  category EventCategory @default(festival)
  status   ContentStatus @default(published)

  titleAz       String  @map("title_az") @db.VarChar(160)
  titleEn       String? @map("title_en") @db.VarChar(160)
  descriptionAz String? @map("description_az") @db.Text

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  startTime String?  @map("start_time") @db.VarChar(5)
  endTime   String?  @map("end_time") @db.VarChar(5)

  venue String?  @db.VarChar(190)
  lat   Decimal? @db.Decimal(10, 7)
  lng   Decimal? @db.Decimal(10, 7)

  isFree    Boolean  @default(true) @map("is_free")
  priceAzn  Decimal? @map("price_azn") @db.Decimal(8, 2)
  organizer String?  @db.VarChar(160)
  coverId   BigInt?  @map("cover_id") @db.UnsignedBigInt

  attendeeCount Int @default(0) @map("attendee_count") @db.UnsignedInt

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  region    Region          @relation(fields: [regionId], references: [id], onDelete: Restrict)
  cover     MediaAsset?     @relation(fields: [coverId], references: [id], onDelete: SetNull)
  attendees EventAttendee[]
  tripItems TripItem[]

  @@index([regionId, startDate])
  @@index([startDate, endDate])
  @@index([category, status])
  @@fulltext([titleAz, descriptionAz])
  @@map("events")
}

model EventAttendee {
  eventId   BigInt   @map("event_id") @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_attendees")
}

model Business {
  id       BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId String        @unique @map("public_id") @db.Char(26)
  slug     String        @unique @db.VarChar(120)
  ownerId  BigInt?       @map("owner_id") @db.UnsignedBigInt
  regionId BigInt        @map("region_id") @db.UnsignedBigInt
  type     BusinessType  @default(otel)
  status   ContentStatus @default(published)

  name          String  @db.VarChar(160)
  descriptionAz String? @map("description_az") @db.Text
  services      String? @db.VarChar(255) // "spa|hovuz|restoran"

  lat     Decimal? @db.Decimal(10, 7)
  lng     Decimal? @db.Decimal(10, 7)
  address String?  @db.VarChar(255)
  phone   String?  @db.VarChar(24)
  website String?  @db.VarChar(190)

  coverId BigInt? @map("cover_id") @db.UnsignedBigInt
  logoId  BigInt? @map("logo_id") @db.UnsignedBigInt

  ratingAvg   Decimal @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount Int     @default(0) @map("rating_count") @db.UnsignedInt
  isVerified  Boolean @default(false) @map("is_verified")

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  owner    User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  region   Region            @relation(fields: [regionId], references: [id], onDelete: Restrict)
  cover    MediaAsset?       @relation("BusinessCover", fields: [coverId], references: [id], onDelete: SetNull)
  logo     MediaAsset?       @relation("BusinessLogo", fields: [logoId], references: [id], onDelete: SetNull)
  packages BusinessPackage[]
  photos   BusinessPhoto[]

  @@index([regionId, type, status])
  @@index([ownerId])
  @@fulltext([name, descriptionAz])
  @@map("businesses")
}

model BusinessPackage {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  publicId      String   @unique @map("public_id") @db.Char(26)
  businessId    BigInt   @map("business_id") @db.UnsignedBigInt
  titleAz       String   @map("title_az") @db.VarChar(160)
  descriptionAz String?  @map("description_az") @db.Text
  nights        Int      @default(1) @db.UnsignedTinyInt
