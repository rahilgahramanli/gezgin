// ═══════════════ 3. MARŞRUT & TƏCRÜBƏ (9 cədvəl) ═══════════════

model Route {
  id         BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  publicId   String          @unique @map("public_id") @db.Char(26)
  slug       String          @unique @db.VarChar(120)
  authorId   BigInt?         @map("author_id") @db.UnsignedBigInt
  regionId   BigInt          @map("region_id") @db.UnsignedBigInt
  categoryId BigInt?         @map("category_id") @db.UnsignedBigInt
  visibility RouteVisibility @default(public)
  status     ContentStatus   @default(published)

  days       Int             @default(1) @db.UnsignedTinyInt
  nights     Int             @default(0) @db.UnsignedTinyInt
  distanceKm Decimal?        @map("distance_km") @db.Decimal(7, 2)
  difficulty RouteDifficulty @default(asan)
  categories String?         @db.VarChar(160) // "tebiet|macera"
  coverId    BigInt?         @map("cover_id") @db.UnsignedBigInt

  ratingAvg   Decimal @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount Int     @default(0) @map("rating_count") @db.UnsignedInt
  copyCount   Int     @default(0) @map("copy_count") @db.UnsignedInt
  saveCount   Int     @default(0) @map("save_count") @db.UnsignedInt

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  author       User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  region       Region             @relation(fields: [regionId], references: [id], onDelete: Restrict)
  category     Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cover        MediaAsset?        @relation(fields: [coverId], references: [id], onDelete: SetNull)
  translations RouteTranslation[]
  routeDays    RouteDay[]
  stops        RouteStop[]
  trips        Trip[]
  posts        Post[]

  @@index([regionId, visibility, status])
  @@index([authorId])
  @@index([ratingAvg(sort: Desc)])
  @@map("routes")
}

model RouteTranslation {
  routeId     BigInt   @map("route_id") @db.UnsignedBigInt
  lang        Language
  title       String   @db.VarChar(160)
  description String?  @db.Text

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@id([routeId, lang])
  @@fulltext([title, description])
  @@map("route_translations")
}

model RouteDay {
  id        BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  routeId   BigInt  @map("route_id") @db.UnsignedBigInt
  dayNumber Int     @map("day_number") @db.UnsignedTinyInt
  titleAz   String? @map("title_az") @db.VarChar(160)
  noteAz    String? @map("note_az") @db.Text

  route Route       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stops RouteStop[]

  @@unique([routeId, dayNumber])
  @@map("route_days")
}

model RouteStop {
  id          BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  routeId     BigInt  @map("route_id") @db.UnsignedBigInt
  routeDayId  BigInt? @map("route_day_id") @db.UnsignedBigInt
  placeId     BigInt  @map("place_id") @db.UnsignedBigInt
  dayNumber   Int     @default(1) @map("day_number") @db.UnsignedTinyInt
  sortOrder   Int     @default(0) @map("sort_order") @db.UnsignedSmallInt
  arriveTime  String? @map("arrive_time") @db.VarChar(5)
  durationMin Int?    @map("duration_min") @db.UnsignedSmallInt
  noteAz      String? @map("note_az") @db.VarChar(500)

  route    Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  // Cascade (SetNull deyil): MySQL eyni cədvəli iki fərqli kaskad yolu ilə
  // dəyişdirməyə icazə vermir. `routes` silinəndə həm `route_days` (CASCADE),
  // həm də `route_stops` (CASCADE) silinir; `route_days`-dən SET NULL gəlsəydi,
  // MySQL silinməkdə olan sətirləri yeniləməyə çalışıb xəta verərdi.
  // Günü tək silərkən dayanacaqlar əvvəlcə başqa günə köçürülür (bax RoutesService).
  routeDay RouteDay? @relation(fields: [routeDayId], references: [id], onDelete: Cascade)
  place    Place     @relation(fields: [placeId], references: [id], onDelete: Restrict)

  @@unique([routeId, dayNumber, sortOrder])
  @@index([placeId])
  @@index([routeDayId])
  @@map("route_stops")
}

model ExpertProfile {
  userId              BigInt    @id @map("user_id") @db.UnsignedBigInt
  headlineAz          String?   @map("headline_az") @db.VarChar(190)
  bioAz               String?   @map("bio_az") @db.Text
  specialties         String?   @db.VarChar(255) // "beledci|qastronomiya"
  languages           String?   @db.VarChar(60) // "az|ru|en"
  regions             String?   @db.VarChar(255) // "quba|qusar"
  yearsActive         Int?      @map("years_active") @db.UnsignedTinyInt
  ratingAvg           Decimal   @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount         Int       @default(0) @map("rating_count") @db.UnsignedInt
  experienceCount     Int       @default(0) @map("experience_count") @db.UnsignedInt
  payoutRate          Decimal   @default(0.80) @map("payout_rate") @db.Decimal(4, 3)
  isAcceptingBookings Boolean   @default(true) @map("is_accepting_bookings")
  approvedAt          DateTime? @map("approved_at") @db.DateTime(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ratingAvg(sort: Desc)])
  @@map("expert_profiles")
}

model Experience {
  id         BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId   String        @unique @map("public_id") @db.Char(26)
  slug       String        @unique @db.VarChar(120)
  expertId   BigInt        @map("expert_id") @db.UnsignedBigInt
  regionId   BigInt        @map("region_id") @db.UnsignedBigInt
  placeId    BigInt?       @map("place_id") @db.UnsignedBigInt
  categoryId BigInt?       @map("category_id") @db.UnsignedBigInt
  status     ContentStatus @default(published)

  titleAz       String  @map("title_az") @db.VarChar(160)
  titleEn       String? @map("title_en") @db.VarChar(160)
  descriptionAz String? @map("description_az") @db.Text

  duration     ExperienceDuration @default(half_day)
  durationText String?            @map("duration_text") @db.VarChar(40)
  priceAzn     Decimal            @map("price_azn") @db.Decimal(10, 2)
  maxGroup     Int                @default(10) @map("max_group") @db.UnsignedTinyInt
  minGroup     Int                @default(1) @map("min_group") @db.UnsignedTinyInt

  meetingPoint String?  @map("meeting_point") @db.VarChar(255)
  lat          Decimal? @db.Decimal(10, 7)
  lng          Decimal? @db.Decimal(10, 7)

  ratingAvg    Decimal @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount  Int     @default(0) @map("rating_count") @db.UnsignedInt
  bookingCount Int     @default(0) @map("booking_count") @db.UnsignedInt
  isFeatured   Boolean @default(false) @map("is_featured")

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  expert     User                  @relation(fields: [expertId], references: [id], onDelete: Cascade)
  region     Region                @relation(fields: [regionId], references: [id], onDelete: Restrict)
  place      Place?                @relation(fields: [placeId], references: [id], onDelete: SetNull)
  category   Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  photos     ExperiencePhoto[]
  slots      ExperienceSlot[]
  inclusions ExperienceInclusion[]
  bookings   Booking[]
  tripItems  TripItem[]

  @@index([regionId, status])
  @@index([expertId, status])
  @@index([isFeatured, ratingAvg(sort: Desc)])
  @@fulltext([titleAz, descriptionAz])
  @@map("experiences")
}

model ExperiencePhoto {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  experienceId BigInt   @map("experience_id") @db.UnsignedBigInt
  mediaId      BigInt   @map("media_id") @db.UnsignedBigInt
  isCover      Boolean  @default(false) @map("is_cover")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  media      MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([experienceId, isCover, sortOrder])
  @@index([mediaId])
  @@map("experience_photos")
}

model ExperienceSlot {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  experienceId BigInt    @map("experience_id") @db.UnsignedBigInt
  startAt      DateTime  @map("start_at") @db.DateTime(3)
  endAt        DateTime? @map("end_at") @db.DateTime(3)
  capacity     Int       @default(10) @db.UnsignedTinyInt
  booked       Int       @default(0) @db.UnsignedTinyInt
  priceAzn     Decimal?  @map("price_azn") @db.Decimal(10, 2)
  isCancelled  Boolean   @default(false) @map("is_cancelled")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@unique([experienceId, startAt])
  @@index([startAt])
  @@map("experience_slots")
}

model ExperienceInclusion {
  id           BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  experienceId BigInt  @map("experience_id") @db.UnsignedBigInt
  code         String  @db.VarChar(40) // beledci, neqliyyat, yerli-nahar, sigorta, materiallar
  nameAz       String  @map("name_az") @db.VarChar(80)
  icon         String? @db.VarChar(60)
  isIncluded   Boolean @default(true) @map("is_included")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, code])
  @@map("experience_inclusions")
}

// ═══════════════════ 4. PLANLAMA (5 cədvəl) ═══════════════════

model Trip {
  id             BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String     @unique @map("public_id") @db.Char(26)
  userId         BigInt     @map("user_id") @db.UnsignedBigInt
  routeId        BigInt?    @map("route_id") @db.UnsignedBigInt
  title          String     @db.VarChar(160)
  status         TripStatus @default(planned)
  startDate      DateTime?  @map("start_date") @db.Date
  endDate        DateTime?  @map("end_date") @db.Date
  travelers      Int        @default(1) @db.UnsignedTinyInt
  coverId        BigInt?    @map("cover_id") @db.UnsignedBigInt
  offlineEnabled Boolean    @default(false) @map("offline_enabled")
  startedAt      DateTime?  @map("started_at") @db.DateTime(3)
  completedAt    DateTime?  @map("completed_at") @db.DateTime(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  route Route?      @relation(fields: [routeId], references: [id], onDelete: SetNull)
  cover MediaAsset? @relation(fields: [coverId], references: [id], onDelete: SetNull)
  days  TripDay[]
  items TripItem[]
  notes TripNote[]

  @@index([userId, status, startDate])
  @@index([routeId])
  @@map("trips")
}

model TripDay {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tripId    BigInt    @map("trip_id") @db.UnsignedBigInt
  dayNumber Int       @map("day_number") @db.UnsignedTinyInt
  date      DateTime? @db.Date
  titleAz   String?   @map("title_az") @db.VarChar(160)

  trip  Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items TripItem[]

  @@unique([tripId, dayNumber])
  @@map("trip_days")
}

model TripItem {
  id           BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  tripId       BigInt       @map("trip_id") @db.UnsignedBigInt
  tripDayId    BigInt?      @map("trip_day_id") @db.UnsignedBigInt
  type         TripItemType
  placeId      BigInt?      @map("place_id") @db.UnsignedBigInt
  experienceId BigInt?      @map("experience_id") @db.UnsignedBigInt
  eventId      BigInt?      @map("event_id") @db.UnsignedBigInt
  bookingId    BigInt?      @map("booking_id") @db.UnsignedBigInt

  customTitle String?   @map("custom_title") @db.VarChar(160)
  startTime   String?   @map("start_time") @db.VarChar(5)
  durationMin Int?      @map("duration_min") @db.UnsignedSmallInt
  sortOrder   Int       @default(0) @map("sort_order") @db.UnsignedSmallInt
  noteAz      String?   @map("note_az") @db.VarChar(500)
  isDone      Boolean   @default(false) @map("is_done")
  doneAt      DateTime? @map("done_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  trip       Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  // Cascade — səbəb üçün bax: RouteStop.routeDay. Bu olmadan istifadəçi
  // hesabının silinməsi (users → trips → trip_days/trip_items) MySQL-də xəta verirdi.
  tripDay    TripDay?    @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  place      Place?      @relation(fields: [placeId], references: [id], onDelete: SetNull)
  experience Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  event      Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  booking    Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([tripId, tripDayId, sortOrder])
  @@index([placeId])
  @@index([experienceId])
  @@index([eventId])
  @@index([bookingId])
  @@map("trip_items")
}

model TripNote {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tripId    BigInt   @map("trip_id") @db.UnsignedBigInt
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@map("trip_notes")
}

model OfflinePackage {
  id          BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  regionId    BigInt               @unique @map("region_id") @db.UnsignedBigInt
  status      OfflinePackageStatus @default(available)
  version     Int                  @default(1) @db.UnsignedInt
  sizeMb      Int                  @default(0) @map("size_mb") @db.UnsignedInt
  placeCount  Int                  @default(0) @map("place_count") @db.UnsignedInt
  manifestUrl String?              @map("manifest_url") @db.VarChar(500)
  builtAt     DateTime?            @map("built_at") @db.DateTime(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  region    Region            @relation(fields: [regionId], references: [id], onDelete: Cascade)
  downloads OfflineDownload[]

  @@map("offline_packages")
}

model OfflineDownload {
  packageId    BigInt   @map("package_id") @db.UnsignedBigInt
  userId       BigInt   @map("user_id") @db.UnsignedBigInt
  version      Int      @db.UnsignedInt
  downloadedAt DateTime @default(now()) @map("downloaded_at") @db.DateTime(3)

  package OfflinePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([packageId, userId])
  @@index([userId])
  @@map("offline_downloads")
}

// ═══════════════════ 5. REZERVASİYA (6 cədvəl) ═══════════════════

model Booking {
  id       BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  publicId String        @unique @map("public_id") @db.Char(26)
  code     String        @unique @db.VarChar(16) // GZ-27A4K9 — ekran 19, 53
  userId   BigInt        @map("user_id") @db.UnsignedBigInt
  type     BookingType
  status   BookingStatus @default(pending)

  experienceId BigInt? @map("experience_id") @db.UnsignedBigInt
  slotId       BigInt? @map("slot_id") @db.UnsignedBigInt
  packageId    BigInt? @map("package_id") @db.UnsignedBigInt

  startAt  DateTime  @map("start_at") @db.DateTime(3)
  endAt    DateTime? @map("end_at") @db.DateTime(3)
  adults   Int       @default(1) @db.UnsignedTinyInt
  children Int       @default(0) @db.UnsignedTinyInt

  subtotalAzn   Decimal @map("subtotal_azn") @db.Decimal(10, 2)
  extrasAzn     Decimal @default(0) @map("extras_azn") @db.Decimal(10, 2)
  serviceFeeAzn Decimal @default(0) @map("service_fee_azn") @db.Decimal(10, 2)
  totalAzn      Decimal @map("total_azn") @db.Decimal(10, 2)

  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(64)
  note           String? @db.VarChar(500)
  cancelReason   String? @map("cancel_reason") @db.VarChar(255)

  confirmedAt DateTime? @map("confirmed_at") @db.DateTime(3)
  cancelledAt DateTime? @map("cancelled_at") @db.DateTime(3)
  completedAt DateTime? @map("completed_at") @db.DateTime(3)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  experience Experience?      @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  slot       ExperienceSlot?  @relation(fields: [slotId], references: [id], onDelete: SetNull)
  package    BusinessPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  items      BookingItem[]
  payments   Payment[]
  commission Commission?
  tripItems  TripItem[]

  @@index([userId, status, startAt])
  @@index([experienceId, startAt])
  @@index([packageId, startAt])
  @@index([status, startAt])
  @@map("bookings")
}

model BookingItem {
  id        BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  bookingId BigInt  @map("booking_id") @db.UnsignedBigInt
  code      String  @db.VarChar(40) // transfer, sigorta, spa
  nameAz    String  @map("name_az") @db.VarChar(120)
  quantity  Int     @default(1) @db.UnsignedSmallInt
  unitAzn   Decimal @map("unit_azn") @db.Decimal(10, 2)
  totalAzn  Decimal @map("total_azn") @db.Decimal(10, 2)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_items")
}

model Payment {
  id             BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  publicId       String              @unique @map("public_id") @db.Char(26)
  bookingId      BigInt?             @map("booking_id") @db.UnsignedBigInt
  subscriptionId BigInt?             @map("subscription_id") @db.UnsignedBigInt
  provider       PaymentProviderCode @default(mock)
  status         PaymentStatus       @default(created)

  amountAzn   Decimal @map("amount_azn") @db.Decimal(10, 2)
  refundedAzn Decimal @default(0) @map("refunded_azn") @db.Decimal(10, 2)
  currency    String  @default("AZN") @db.Char(3)

  providerIntentId  String? @map("provider_intent_id") @db.VarChar(190)
  providerPaymentId String? @map("provider_payment_id") @db.VarChar(190)
  methodId          BigInt? @map("method_id") @db.UnsignedBigInt
  failureCode       String? @map("failure_code") @db.VarChar(60)
  failureMessage    String? @map("failure_message") @db.VarChar(255)
  rawPayload        Json?   @map("raw_payload")

  paidAt     DateTime? @map("paid_at") @db.DateTime(3)
  refundedAt DateTime? @map("refunded_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  booking      Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  subscription Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  method       PaymentMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([subscriptionId])
  @@index([status, createdAt])
  @@index([providerIntentId])
  @@index([methodId])
  @@map("payments")
}

model PaymentMethod {
  id            BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  // Xaricə açıq identifikator — ardıcıl `id` sızdırılmır
  publicId      String              @unique @map("public_id") @db.Char(26)
  userId        BigInt              @map("user_id") @db.UnsignedBigInt
  provider      PaymentProviderCode @default(mock)
  brand         String?             @db.VarChar(24) // visa, mastercard
  last4         String?             @db.Char(4)
  expMonth      Int?                @map("exp_month") @db.UnsignedTinyInt
  expYear       Int?                @map("exp_year") @db.UnsignedSmallInt
  holderName    String?             @map("holder_name") @db.VarChar(120)
  // PAN heç vaxt saxlanılmır — yalnız provayderin tokeni
  providerToken String              @map("provider_token") @db.VarChar(255)
  isDefault     Boolean             @default(false) @map("is_default")
  createdAt     DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  deletedAt     DateTime?           @map("deleted_at") @db.DateTime(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId, isDefault])
  @@map("payment_methods")
}

model Commission {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  bookingId   BigInt   @unique @map("booking_id") @db.UnsignedBigInt
  grossAzn    Decimal  @map("gross_azn") @db.Decimal(10, 2)
