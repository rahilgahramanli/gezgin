// ═══════════════════════════════════════════════════════════════════════
//  GEZGIN.app — Prisma sxemi (MySQL 8.4)
//  Mənbə: TECH-PLAN.md §4 · design/ (56 ekran) · seed/ (CSV şablonları)
//
//  Qaydalar:
//   • Daxili ID: BigInt autoincrement · xaricə açıq: publicId (ULID, 26 simvol)
//   • Bütün tarixlər UTC · soft delete: deletedAt
//   • Çoxdilli kontent ayrıca *Translation modelində (AZ/EN/RU)
//   • Coğrafi sorğular: lat/lng Decimal + `geo POINT SRID 4326` generated sütunu
//     (migration SQL-də əlavə olunur, sorğular $queryRaw ilə — bax prisma/sql/)
// ═══════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─────────────────────────── ENUM-lar ───────────────────────────

enum UserRole {
  gezgin
  local_expert
  business
  admin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum Language {
  az
  en
  ru
}

enum Gender {
  female
  male
  other
  unspecified
}

enum OtpChannel {
  email
  sms
}

enum OtpPurpose {
  register
  login
  password_reset
  email_change
  phone_change
}

enum DevicePlatform {
  ios
  android
  web
}

enum MediaType {
  image
  video
  audio
  document
}

enum MediaStatus {
  pending
  ready
  failed
}

enum ContentStatus {
