  termsAcceptedAt DateTime?               @map("terms_accepted_at") @db.DateTime(3)
  submittedAt     DateTime?               @map("submitted_at") @db.DateTime(3)
  reviewedById    BigInt?                 @map("reviewed_by_id") @db.UnsignedBigInt
  reviewedAt      DateTime?               @map("reviewed_at") @db.DateTime(3)
  rejectReason    String?                 @map("reject_reason") @db.VarChar(500)
  createdAt       DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  idDocument  MediaAsset? @relation("ExpertIdDoc", fields: [idDocumentId], references: [id], onDelete: SetNull)
  certificate MediaAsset? @relation("ExpertCert", fields: [certificateId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@map("expert_applications")
}

model SubscriptionPlan {
  id              BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  code            SubscriptionPlanCode
  interval        String               @db.VarChar(10) // month | year
  nameAz          String               @map("name_az") @db.VarChar(120)
  priceAzn        Decimal              @map("price_azn") @db.Decimal(10, 2)
  appleProductId  String?              @map("apple_product_id") @db.VarChar(120)
  googleProductId String?              @map("google_product_id") @db.VarChar(120)
  features        Json?
  trialDays       Int                  @default(0) @map("trial_days") @db.UnsignedTinyInt
  isActive        Boolean              @default(true) @map("is_active")
  sortOrder       Int                  @default(0) @map("sort_order")

  subscriptions Subscription[]

  @@unique([code, interval])
  @@map("subscription_plans")
}

model Subscription {
  id       BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  publicId String              @unique @map("public_id") @db.Char(26)
  userId   BigInt              @map("user_id") @db.UnsignedBigInt
  planId   BigInt              @map("plan_id") @db.UnsignedBigInt
  status   SubscriptionStatus  @default(active)
  provider PaymentProviderCode @default(mock)

  currentPeriodStart DateTime  @map("current_period_start") @db.DateTime(3)
  currentPeriodEnd   DateTime  @map("current_period_end") @db.DateTime(3)
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  cancelledAt        DateTime? @map("cancelled_at") @db.DateTime(3)
  trialEndsAt        DateTime? @map("trial_ends_at") @db.DateTime(3)

  providerSubscriptionId String? @map("provider_subscription_id") @db.VarChar(190)
  latestReceipt          String? @map("latest_receipt") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@index([planId])
  @@map("subscriptions")
}

model MediaAsset {
  id       BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  publicId String      @unique @map("public_id") @db.Char(26)
  ownerId  BigInt?     @map("owner_id") @db.UnsignedBigInt
  type     MediaType   @default(image)
  status   MediaStatus @default(pending)

  storageKey String  @map("storage_key") @db.VarChar(500)
  mimeType   String  @map("mime_type") @db.VarChar(80)
  sizeBytes  Int     @default(0) @map("size_bytes") @db.UnsignedInt
  width      Int?    @db.UnsignedSmallInt
  height     Int?    @db.UnsignedSmallInt
  durationS  Int?    @map("duration_s") @db.UnsignedSmallInt
  blurhash   String? @db.VarChar(60)
  variants   Json? // { thumb, card, full }
  altText    String? @map("alt_text") @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)

  owner User? @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  userAvatars      User[]              @relation("UserAvatar")
  userCovers       User[]              @relation("UserCover")
  regionCovers     Region[]
  placePhotos      PlacePhoto[]
  eventCovers      Event[]
  businessCovers   Business[]          @relation("BusinessCover")
  businessLogos    Business[]          @relation("BusinessLogo")
  businessPhotos   BusinessPhoto[]
  routeCovers      Route[]
  experiencePhotos ExperiencePhoto[]
  tripCovers       Trip[]
  postMedia        PostMedia[]
  stories          Story[]
  reviewPhotos     ReviewPhoto[]
  collectionCovers Collection[]
  messages         Message[]
  expertIdDocs     ExpertApplication[] @relation("ExpertIdDoc")
  expertCerts      ExpertApplication[] @relation("ExpertCert")

  @@index([ownerId, createdAt])
  @@index([status])
  @@map("media_assets")
}

model AppSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  isPublic  Boolean  @default(false) @map("is_public")
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("app_settings")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  actorId    BigInt?  @map("actor_id") @db.UnsignedBigInt
  action     String   @db.VarChar(80)
  targetType String?  @map("target_type") @db.VarChar(40)
  targetId   BigInt?  @map("target_id") @db.UnsignedBigInt
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ═══════════════════ 11. AXTARIŞ (1 cədvəl) ═══════════════════

model SearchHistory {
  id          BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt            @map("user_id") @db.UnsignedBigInt
  query       String            @db.VarChar(190)
  entityType  SearchEntityType? @map("entity_type")
  resultCount Int               @default(0) @map("result_count") @db.UnsignedInt
  createdAt   DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("search_history")
}
