<resources>

    <!-- Android 12+ öz SplashScreen API-sini işlədir: `windowBackground` deyil,
         aşağıdakı atributlar oxunur. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowSplashScreenBackground">@color/brand_green</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_logo</item>
    </style>

</resources>
