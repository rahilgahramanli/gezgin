# ─────────── Ümumi ───────────
NODE_ENV=development
TZ=UTC

# ─────────── MySQL ───────────
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=gezgin
MYSQL_USER=gezgin
MYSQL_PASSWORD=gezginpass
MYSQL_PORT=3310
DATABASE_URL="mysql://gezgin:gezginpass@localhost:3310/gezgin"

# ─────────── Redis ───────────
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_HOST_PORT=6381
REDIS_PASSWORD=

# ─────────── API ───────────
API_PORT=3100
API_PREFIX=api/v1
API_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:8081,http://localhost:3101

# ─────────── Auth ───────────
JWT_ACCESS_SECRET=dev-access-secret-deyisdirin
JWT_REFRESH_SECRET=dev-refresh-secret-deyisdirin
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ─────────── S3 / MinIO ───────────
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=gezgin
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9010/gezgin
S3_FORCE_PATH_STYLE=true

# ─────────── Mail (dev: mailhog) ───────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="GEZGIN <no-reply@gezgin.app>"

# ─────────── Ödəniş (Sprint 6 — mock) ───────────
PAYMENT_PROVIDER=mock
IAP_PROVIDER=mock

# ─────────── Gamification ───────────
# Check-in üçün məkana maksimum məsafə (metr)
CHECKIN_RADIUS_M=1000

# ─────────── Sosial giriş (Sprint 1 — mock) ───────────
# mock: token "mock:<email>" formatında qəbul edilir (yalnız dev)
# live: real Google/Apple token yoxlaması — kredensiallar tələb olunur
SOCIAL_MODE=mock
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ─────────── Xəritə ───────────
MAPBOX_TOKEN=
SHADOW_DATABASE_URL="mysql://gezgin:gezginpass@localhost:3310/gezgin_shadow"

# ─────────── Docker host portları ───────────
# Digər layihələrlə toqquşmasın deyə GEZGIN-ə xas portlar
PMA_PORT_HOST=8083
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
